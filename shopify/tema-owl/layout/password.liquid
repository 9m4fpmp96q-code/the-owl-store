<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <script>
    try { if (localStorage.getItem('owl-theme') === 'dark') document.documentElement.setAttribute('data-theme', 'dark'); } catch (e) {}
  </script>
  <title>{{ shop.name }}</title>
  {%- if page_description %}
    <meta name="description" content="{{ page_description | escape }}">
  {%- endif %}
  <link rel="icon" type="image/svg+xml" href="{{ 'favicon.svg' | asset_url }}">
  {% render 'meta-tags' %}
  {%- comment -%}
    La fuente se sirve desde el CDN de Shopify (más rápido y sin enviar la IP
    del visitante a Google). Se elige en Configuración del tema → Tipografía.
  {%- endcomment -%}
  {%- liquid
    assign fuente = settings.type_font
    assign fuente_500 = fuente | font_modify: 'weight', '500'
    assign fuente_600 = fuente | font_modify: 'weight', '600'
    assign fuente_700 = fuente | font_modify: 'weight', '700'
    assign fuente_800 = fuente | font_modify: 'weight', '800'
    assign fuente_900 = fuente | font_modify: 'weight', '900'
  -%}
  {{ fuente | font_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
  <style>
    {{ fuente | font_face: font_display: 'swap' }}
    {{ fuente_500 | font_face: font_display: 'swap' }}
    {{ fuente_600 | font_face: font_display: 'swap' }}
    {{ fuente_700 | font_face: font_display: 'swap' }}
    {{ fuente_800 | font_face: font_display: 'swap' }}
    {{ fuente_900 | font_face: font_display: 'swap' }}
    :root { --fuente: {{ fuente.family }}, {{ fuente.fallback_families }}; }
  </style>
  {{ 'base.css' | asset_url | stylesheet_tag }}
  <style>
    :root { --ambar: {{ settings.color_ambar }}; }
    [data-theme="dark"] { --ambar: {{ settings.color_ambar_oscuro }}; }
  </style>
  {{ content_for_header }}
</head>
<body class="password-page">
  <main id="contenido" role="main">
    {{ content_for_layout }}
  </main>
  <footer class="footer-bottom" style="padding:28px 24px;border-top:1px solid var(--border)">
    <span>© {{ 'now' | date: '%Y' }} {{ shop.name | escape }}</span>
    <span>{{ 'password.powered' | t }}</span>
  </footer>
</body>
</html>
