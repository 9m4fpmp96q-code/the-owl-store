{%- comment -%} Formulario de contacto: los mensajes llegan al email de la tienda. {%- endcomment -%}
<div class="pagina" style="padding-top:0">
  {%- form 'contact', class: 'formulario-owl' -%}
    {%- if form.posted_successfully? -%}
      <div class="aviso-form aviso-form--ok" role="status">{{ 'contact.success' | t }}</div>
    {%- endif -%}
    {%- if form.errors -%}
      <div class="aviso-form aviso-form--error" role="alert">{{ form.errors | default_errors }}</div>
    {%- endif -%}

    <div class="campo">
      <label for="ContactoNombre">{{ 'contact.name' | t }}</label>
      <input type="text" id="ContactoNombre" name="contact[name]" autocomplete="name" value="{{ form.name }}">
    </div>
    <div class="campo">
      <label for="ContactoEmail">{{ 'contact.email' | t }}</label>
      <input type="email" id="ContactoEmail" name="contact[email]" autocomplete="email" required value="{{ form.email }}">
    </div>
    <div class="campo">
      <label for="ContactoPedido">{{ 'contact.order' | t }}</label>
      <input type="text" id="ContactoPedido" name="contact[pedido]" value="{{ form.pedido }}">
    </div>
    <div class="campo">
      <label for="ContactoMensaje">{{ 'contact.message' | t }}</label>
      <textarea id="ContactoMensaje" name="contact[body]" required>{{ form.body }}</textarea>
    </div>
    <button type="submit" class="btn-primary">{{ 'contact.send' | t }}</button>
  {%- endform -%}
</div>

{% schema %}
{
  "name": "Formulario de contacto",
  "settings": [],
  "presets": [{ "name": "Formulario de contacto" }]
}
{% endschema %}
