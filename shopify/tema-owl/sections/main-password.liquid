{%- comment -%}
  Página «Próximamente»: la que ve el público mientras la tienda está
  protegida con contraseña. Recoge emails para avisar de la apertura.
{%- endcomment -%}
<div class="caja-centrada">
  <a class="nav-logo" href="{{ routes.root_url }}" style="justify-content:center;margin-bottom:28px">
    {% render 'logo-owl' %}<span>{{ shop.name | escape }}</span>
  </a>
  <h1>{{ section.settings.heading | escape }}</h1>
  {%- if shop.password_message != blank -%}
    <p>{{ shop.password_message }}</p>
  {%- else -%}
    <p>{{ section.settings.text | escape }}</p>
  {%- endif -%}

  {%- form 'customer', class: 'formulario-owl' -%}
    <input type="hidden" name="contact[tags]" value="newsletter,proximamente">
    {%- if form.posted_successfully? -%}
      <div class="aviso-form aviso-form--ok" role="status">{{ 'password.subscribed' | t }}</div>
    {%- else -%}
      {%- if form.errors -%}
        <div class="aviso-form aviso-form--error" role="alert">{{ form.errors | default_errors }}</div>
      {%- endif -%}
      <div class="password-fila">
        <input type="email" name="contact[email]" required autocomplete="email" placeholder="{{ 'password.email' | t }}" aria-label="{{ 'password.email' | t }}">
        <button type="submit" class="btn-primary">{{ 'password.notify' | t }}</button>
      </div>
      <p style="font-size:13px;margin:14px 0 0">
        {{ 'password.consent' | t }}
        {%- if shop.privacy_policy.url != blank %} <a href="{{ shop.privacy_policy.url }}">{{ 'footer.privacy' | t }}</a>{% endif -%}
      </p>
    {%- endif -%}
  {%- endform -%}

  <details class="password-duenio">
    <summary>{{ 'password.owner' | t }}</summary>
    {%- form 'storefront_password', class: 'formulario-owl' -%}
      {%- if form.errors -%}
        <div class="aviso-form aviso-form--error" role="alert">{{ form.errors | default_errors }}</div>
      {%- endif -%}
      <div class="password-fila">
        <input type="password" name="password" required autocomplete="current-password" placeholder="{{ 'password.password' | t }}" aria-label="{{ 'password.password' | t }}">
        <button type="submit" class="btn-outline">{{ 'password.enter' | t }}</button>
      </div>
    {%- endform -%}
  </details>
</div>

{% schema %}
{
  "name": "Próximamente",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titular", "default": "Abrimos muy pronto." },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "Los OWL Buds se están fabricando. Déjanos tu email y te avisamos el día que abramos: un solo mensaje, sin spam." }
  ]
}
{% endschema %}
