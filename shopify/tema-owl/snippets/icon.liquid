{%- comment -%}
  Iconos del tema (los mismos trazos que la web original).
  Uso: {% render 'icon', nombre: 'camion', tamano: 20 %}
{%- endcomment -%}
{%- assign t = tamano | default: 20 -%}
<svg width="{{ t }}" height="{{ t }}" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  {%- case nombre -%}
    {%- when 'escudo' -%}<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
    {%- when 'check' -%}<path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="M22 4L12 14.01l-3-3"/>
