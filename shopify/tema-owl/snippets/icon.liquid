    {%- when 'corazon' -%}<path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
    {%- when 'flecha' -%}<path d="M5 12h14M12 5l7 7-7 7"/>
    {%- when 'carrito' -%}<path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/>
    {%- when 'buscar' -%}<circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
    {%- else -%}<circle cx="12" cy="12" r="10"/>
  {%- endcase -%}
</svg>
