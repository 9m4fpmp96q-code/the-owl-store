{%- comment -%}
  Ilustración del pack OWL (auriculares, funda con el logo y mosquetón).
  Se muestra mientras no haya fotos del producto real: poner fotos de otro
  producto no es una opción.

  Uso:
    {% render 'ilustracion-pack', simbolo: true %}  → define el símbolo SVG (una vez, en theme.liquid)
    {% render 'ilustracion-pack' %}                 → dibuja la ilustración

  Los colores salen de variables CSS, así que se adapta al modo oscuro.
{%- endcomment -%}
{%- if simbolo -%}
<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
  <symbol id="ilu-pack" viewBox="0 0 400 480">
    <circle cx="200" cy="236" r="158" fill="var(--ambar-soft)"/>
    <g fill="none" stroke="var(--ilu-linea)" stroke-width="9" stroke-linecap="round">
      <path d="M306 74c0-21 17-38 38-38s38 17 38 38-17 38-38 38h-20"/>
      <path d="M310 92l-16 16 16 16"/>
    </g>
    <g transform="translate(92 96) rotate(-16 33 33)">
      <rect x="18" y="52" width="30" height="92" rx="15" fill="var(--ilu-cuerpo)" stroke="var(--ilu-linea)" stroke-width="7"/>
      <circle cx="33" cy="38" r="35" fill="var(--ilu-cuerpo)" stroke="var(--ilu-linea)" stroke-width="7"/>
      <circle cx="33" cy="38" r="13" fill="var(--ambar)"/>
    </g>
    <g transform="translate(212 74) rotate(14 33 33)">
      <rect x="18" y="52" width="30" height="92" rx="15" fill="var(--ilu-cuerpo)" stroke="var(--ilu-linea)" stroke-width="7"/>
      <circle cx="33" cy="38" r="35" fill="var(--ilu-cuerpo)" stroke="var(--ilu-linea)" stroke-width="7"/>
      <circle cx="33" cy="38" r="13" fill="var(--ambar)"/>
    </g>
    <g>
      <rect x="104" y="252" width="192" height="176" rx="46" fill="var(--ilu-sombra)"/>
      <rect x="96" y="244" width="192" height="176" rx="46" fill="var(--ilu-cuerpo)" stroke="var(--ilu-linea)" stroke-width="8"/>
      <path d="M96 296h192" stroke="var(--ilu-linea)" stroke-width="6" stroke-linecap="round"/>
      <circle cx="192" cy="272" r="7" fill="var(--ambar)"/>
      <g transform="translate(154 330) scale(1.9)">
        <circle cx="20" cy="20" r="20" fill="var(--ilu-linea)"/>
        <path d="M9.5 6C10.4 9.6 11.6 11.8 13.2 13.2C15.1 11.6 17.4 10.7 20 10.7C22.6 10.7 24.9 11.6 26.8 13.2C28.4 11.8 29.6 9.6 30.5 6C30.5 6 30.3 11.4 29.3 14.6C30.1 16.4 30.5 18.4 30.5 20.5C30.5 26.6 25.8 31.5 20 31.5C14.2 31.5 9.5 26.6 9.5 20.5C9.5 18.4 9.9 16.4 10.7 14.6C9.7 11.4 9.5 6 9.5 6Z" fill="var(--ilu-cuerpo)"/>
        <circle cx="15.6" cy="19.2" r="3.6" fill="var(--ambar)"/>
        <circle cx="24.4" cy="19.2" r="3.6" fill="var(--ambar)"/>
        <path d="M17.9 22.4h4.2L20 26z" fill="var(--ambar)"/>
      </g>
    </g>
  </symbol>
</svg>
{%- else -%}
<svg class="pack-ilustracion" viewBox="0 0 400 480" role="img" aria-label="{{ 'general.illustration_alt' | t }}">
  <use href="#ilu-pack"/>
</svg>
{%- endif -%}
