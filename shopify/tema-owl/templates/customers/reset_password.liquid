{%- comment -%} Elegir contraseña nueva desde el enlace de recuperación. {%- endcomment -%}
<div class="pagina">
  <span class="page-label">{{ 'customer.label' | t }}</span>
  <h1>{{ 'customer.reset.title' | t }}</h1>
  {%- form 'reset_customer_password', class: 'formulario-owl' -%}
    {%- if form.errors -%}
      <div class="aviso-form aviso-form--error" role="alert">{{ form.errors | default_errors }}</div>
    {%- endif -%}
    <div class="campo">
      <label for="ResPassword">{{ 'customer.password' | t }}</label>
      <input type="password" id="ResPassword" name="customer[password]" autocomplete="new-password" required>
    </div>
    <div class="campo">
      <label for="ResPassword2">{{ 'customer.password_confirm' | t }}</label>
      <input type="password" id="ResPassword2" name="customer[password_confirmation]" autocomplete="new-password" required>
    </div>
    <button type="submit" class="btn-primary">{{ 'customer.reset.submit' | t }}</button>
  {%- endform -%}
</div>
