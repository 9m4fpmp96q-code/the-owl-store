{%- comment -%} Activar la cuenta desde la invitación por email. {%- endcomment -%}
<div class="pagina">
  <span class="page-label">{{ 'customer.label' | t }}</span>
  <h1>{{ 'customer.activate.title' | t }}</h1>
  {%- form 'activate_customer_password', class: 'formulario-owl' -%}
    {%- if form.errors -%}
      <div class="aviso-form aviso-form--error" role="alert">{{ form.errors | default_errors }}</div>
    {%- endif -%}
    <div class="campo">
      <label for="ActPassword">{{ 'customer.password' | t }}</label>
      <input type="password" id="ActPassword" name="customer[password]" autocomplete="new-password" required>
    </div>
    <div class="campo">
      <label for="ActPassword2">{{ 'customer.password_confirm' | t }}</label>
      <input type="password" id="ActPassword2" name="customer[password_confirmation]" autocomplete="new-password" required>
    </div>
    <button type="submit" class="btn-primary">{{ 'customer.activate.submit' | t }}</button>
  {%- endform -%}
</div>
