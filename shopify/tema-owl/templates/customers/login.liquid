{%- comment -%} Inicio de sesión de clientes (cuentas clásicas). {%- endcomment -%}
<div class="pagina">
  <span class="page-label">{{ 'customer.label' | t }}</span>
  <h1>{{ 'customer.login.title' | t }}</h1>

  {%- form 'customer_login', class: 'formulario-owl' -%}
    {%- if form.errors -%}
      <div class="aviso-form aviso-form--error" role="alert">{{ form.errors | default_errors }}</div>
    {%- endif -%}
    <div class="campo">
      <label for="LoginEmail">{{ 'customer.email' | t }}</label>
      <input type="email" id="LoginEmail" name="customer[email]" autocomplete="email" required>
    </div>
    <div class="campo">
      <label for="LoginPassword">{{ 'customer.password' | t }}</label>
      <input type="password" id="LoginPassword" name="customer[password]" autocomplete="current-password" required>
    </div>
    <button type="submit" class="btn-primary">{{ 'customer.login.submit' | t }}</button>
    <p style="margin-top:20px"><a href="{{ routes.account_register_url }}">{{ 'customer.login.create' | t }}</a></p>
  {%- endform -%}

  <details style="margin-top:40px">
    <summary style="cursor:pointer;font-weight:600">{{ 'customer.recover.title' | t }}</summary>
    {%- form 'recover_customer_password', class: 'formulario-owl' -%}
      {%- if form.posted_successfully? -%}
        <div class="aviso-form aviso-form--ok" role="status">{{ 'customer.recover.success' | t }}</div>
      {%- endif -%}
      <div class="campo" style="margin-top:16px">
        <label for="RecoverEmail">{{ 'customer.email' | t }}</label>
        <input type="email" id="RecoverEmail" name="email" autocomplete="email" required>
      </div>
      <button type="submit" class="btn-outline">{{ 'customer.recover.submit' | t }}</button>
    {%- endform -%}
  </details>
</div>
